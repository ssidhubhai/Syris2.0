      "content": {
        "text": null,
        "level": null,
        "markdown": null,
        "description": null,
        "subtitle": null,
        "title": null,
        "latex": "Substitute $N$ into the vertical equilibrium equation: $N \\cos\\theta = mg + ma \\sin\\theta$. Replacing $N$: \\(\\left(\\frac{ma}{\\sin\\theta}\\right)\\cos\\theta = mg + ma \\sin\\theta\\)",
        "equation": null,
        "formula": null,
        "expression": null,
        "annotation": null,
        "id_tag": null,
        "label": null,
        "highlight": null,
        "step_number": 2,
        "explanation": "Substitute $N$ into the vertical equilibrium equation: $N \\cos\\theta = mg + ma \\sin\\theta$. Replacing $N$: \\(\\left(\\frac{ma}{\\sin\\theta}\\right)\\cos\\theta = mg + ma \\sin\\theta\\)",
        "left_title": "Algebraic Rearrangement",
        "left_points": [
          "ma \\cot\\theta = mg + ma \\sin\\theta",
          "ma(\\cot\\theta - \\sin\\theta) = mg"
        ],
        "right_title": "Solving for Acceleration 'a'",
        "right_points": [
          "a = \\frac{g}{\\cot\\theta - \\sin\\theta}",
          "a = g \\tan\\theta"
        ],
        "callout_type": null,
        "canvas_type": null,
        "purpose": "solve acceleration"
      },
      "importance": "critical",
