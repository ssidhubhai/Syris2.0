      "content": {
        "text": null,
        "level": null,
        "markdown": null,
        "description": null,
        "subtitle": null,
        "title": null,
        "latex": "Consider the free-body diagram of the block of mass $m$ in the non-inertial frame of the wedge. The forces acting on the block are: 1) Downward gravitational force $mg$, 2) Normal reaction $N$ perpendicular to the incline, 3) Pseudo force $ma$ acting horizontally to the left.",
        "equation": null,
        "formula": null,
        "expression": null,
        "annotation": null,
        "id_tag": null,
        "label": null,
        "highlight": null,
        "step_number": 1,
        "explanation": "Consider the free-body diagram of the block of mass $m$ in the non-inertial frame of the wedge. The forces acting on the block are: 1) Downward gravitational force $mg$, 2) Normal reaction $N$ perpendicular to the incline, 3) Pseudo force $ma$ acting horizontally to the left.",
        "left_title": "Vertical Equilibrium for Block",
        "left_points": [
          "Normal force component balances gravity and vertical pseudo force component.",
          "N \\cos\\theta = mg + ma \\sin\\theta"
        ],
        "right_title": "Horizontal Equilibrium for Block",
        "right_points": [
          "Pseudo force component balances the horizontal component of normal force.",
          "N \\sin\\theta = ma"
        ],
        "callout_type": null,
        "canvas_type": null,
        "purpose": "FBD component resolution"
      },
      "importance": "critical",
      "layout_preference": "full_width"
    },
    {
