    {
      "id": "node-text-cond",
      "type": "text",
      "content": {
        "text": null,
        "level": null,
        "markdown": "For a function to be differentiable at $x = a$, it must first be continuous at $x = a$. However, continuity does not guarantee differentiability. Let us analyze this through logical implications and standard counterexamples.",
        "description": null,
        "subtitle": null,
        "title": null,
        "latex": null,
        "equation": null,
        "formula": null,
        "expression": null,
