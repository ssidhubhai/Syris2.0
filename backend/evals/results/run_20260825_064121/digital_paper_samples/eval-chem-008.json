        "left_title": "SN1 Mechanism (Unimolecular)",
        "left_points": [
          "Kinetics: Rate = k[Substrate], first-order overall.",
          "Steps: Two-step process via a planar carbocation intermediate.",
          "Carbocation Rearrangement: Possible (hydride or alkyl shifts to form more stable carbocation).",
          "Stereochemical Outcome: Racemization (with partial inversion due to ion-pairing effects)."
        ],
        "right_title": "SN2 Mechanism (Bimolecular)",
        "right_points": [
          "Kinetics: Rate = k[Substrate][Nucleophile], second-order overall.",
          "Steps: Concerted one-step process via a pentavalent transition state.",
          "Carbocation Rearrangement: None, as no carbocation is formed.",
          "Stereochemical Outcome: Complete Walden Inversion (100% inversion of configuration)."
