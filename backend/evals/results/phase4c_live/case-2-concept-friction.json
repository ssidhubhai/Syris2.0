        "id": "node-head-2",
        "type": "heading",
        "content": {
          "text": "Microscopic Interlocking and Cold-Welding",
          "level": 2,
          "markdown": null,
          "description": null,
          "subtitle": null,
          "title": null,
          "latex": null,
          "equation": null,
          "formula": null,
