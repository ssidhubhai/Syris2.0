        "left_title": "SN1 Mechanism (Substitution Nucleophilic Unimolecular)",
        "left_points": [
          "Kinetics: Rate = k[Substrate], first-order overall.",
          "Steps: Two-step process via a planar, achiral carbocation intermediate.",
          "Carbocation Rearrangement: Possible via 1,2-hydride or 1,2-methyl shifts if a more stable carbocation can form.",
          "Stereochemical Outcome: Racemization (formation of both retention and inversion products, often with slight excess of inversion due to ion pairs)."
        ],
        "right_title": "SN2 Mechanism (Substitution Nucleophilic Bimolecular)",
        "right_points": [
          "Kinetics: Rate = k[Substrate][Nucleophile], second-order overall.",
          "Steps: Concerted one-step process through a pentavalent transition state with backside attack.",
          "Carbocation Rearrangement: None, since no carbocation intermediate is formed.",
          "Stereochemical Outcome: Complete Walden inversion of configuration converting (R) to (S)."
        ],
